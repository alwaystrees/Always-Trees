# ---------- ต้องมี ----------
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=alwaystrees

# โดเมนของเว็บ — จุดเดียวในระบบที่เก็บโดเมน
# ตอนนี้:  https://alwaystrees.onrender.com
# วันย้าย: https://alwaystrees.co.th   (แก้ค่านี้ค่าเดียว)
BASE_URL=https://alwaystrees.onrender.com

# true ตอนยังอยู่บน .onrender.com  →  Google จะไม่เก็บข้อมูล
# เปลี่ยนเป็น false วันที่ขึ้นโดเมนจริง
NOINDEX=true

# สร้างด้วย  npm run hash -- <รหัสผ่าน>
ADMIN_PASSWORD_HASH=
# สุ่มยาว ๆ เช่น  openssl rand -hex 32
JWT_SECRET=

# โทเคนให้ GitHub Actions เรียก /api/health และ /api/cron/*
CRON_TOKEN=

# ---------- ไม่ใส่ก็ได้ ----------
# อีเมลแจ้งเตือนสำรองข้อมูลรายเดือน ถ้าไม่ใส่ระบบจะข้ามไป
BREVO_API_KEY=
MAIL_FROM=alwaystrees.at@gmail.com
BACKUP_REMINDER_TO=alwaystrees.at@gmail.com

# เตือนในหน้าหลังบ้านเมื่อไม่ได้ดาวน์โหลดข้อมูลเกินกี่วัน
BACKUP_WARN_DAYS=40

# ตัวจัดเก็บไฟล์ ตอนนี้มีแค่ mongo — อนาคตจะมี r2
STORAGE_DRIVER=mongo
